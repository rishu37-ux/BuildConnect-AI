# --- Backend ---
PORT=4000
DATABASE_URL=postgres://buildconnect:buildconnect@localhost:5432/buildconnect
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
# Shared secret the scraper uses to push leads to /api/ingest
INGEST_API_KEY=change-me-ingest-key
# Bootstrap admin created by `npm run seed`
SEED_ADMIN_EMAIL=admin@buildconnect.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# --- Scraper ---
BC_API_URL=http://localhost:4000/api
BC_INGEST_API_KEY=change-me-ingest-key
# Comma-separated proxy URLs, e.g. http://user:pass@host:port
BC_PROXIES=
BC_USER_AGENT=BuildConnectBot/0.1 (+https://example.com/bot; contact@example.com)

# --- Frontend ---
VITE_API_URL=http://localhost:4000/api
