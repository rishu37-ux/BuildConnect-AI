# --- Backend ---
PORT=4000
DATABASE_URL=postgres://buildconnect:buildconnect@localhost:5432/buildconnect
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
# Shared secret the scraper uses to push leads to /api/ingest
INGEST_API_KEY=change-me-ingest-key
# Bootstrap admin created by `npm run seed`
SEED_ADMIN_EMAIL=admin@buildconnect.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# --- Scraper ---
BC_API_URL=http://localhost:4000/api
BC_INGEST_API_KEY=change-me-ingest-key
# Comma-separated proxy URLs, e.g. http://user:pass@host:port
BC_PROXIES=
BC_USER_AGENT=BuildConnectBot/0.1 (+https://example.com/bot; contact@example.com)
# Web search used by the discovery agent: brave (https://brave.com/search/api/)
# or serpapi (https://serpapi.com/). Required for dashboard campaigns.
BC_SEARCH_PROVIDER=brave
BC_SEARCH_API_KEY=
# How many crawler agents work in parallel during a campaign
BC_CRAWLER_AGENTS=3
# Don't re-crawl a website that was crawled within this many days
BC_RECRAWL_AFTER_DAYS=30

# --- Frontend ---
VITE_API_URL=http://localhost:4000/api
